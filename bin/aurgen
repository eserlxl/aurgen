#!/bin/bash
# Copyright © 2025 Eser KUBALI <lxldev.contact@gmail.com>
# SPDX-License-Identifier: GPL-3.0-or-later
#
# This file is part of AURGen project and is licensed under
# the GNU General Public License v3.0 or later.
# See the LICENSE file in the project root for details.

# AURGen main CLI entrypoint

# Bash ranges such as [a-z] follow LC_COLLATE, and a Turkish locale leaves i and I
# out of them, so names like linux-cleaner fail validation. LC_ALL would override
# LC_COLLATE, so its value moves to LANG before collation is pinned to C.
if [[ -n "${LC_ALL:-}" ]]; then
    export LANG="$LC_ALL"
    unset LC_ALL
fi
export LC_COLLATE=C

# Get version from VERSION file
AURGEN_BIN="$(realpath "$0")"
SCRIPT_DIR="$(dirname "$AURGEN_BIN")"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
VERSION_FILE="$PROJECT_ROOT/VERSION"

if [[ -f "$VERSION_FILE" ]]; then
    AURGEN_VERSION=$(tr -d '[:space:]' < "$VERSION_FILE")
else
    AURGEN_VERSION="unknown"
fi

export AURGEN_VERSION AURGEN_BIN
# User-owned state dir (0700) so a shared /tmp path cannot be planted as a symlink
AURGEN_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/aurgen"
mkdir -p "$AURGEN_STATE_DIR"
chmod 0700 "$AURGEN_STATE_DIR"

# Set log file paths
AURGEN_LOG="${AURGEN_LOG:-$AURGEN_STATE_DIR/aurgen.log}"
AURGEN_ERROR_LOG="${AURGEN_ERROR_LOG:-$AURGEN_STATE_DIR/aurgen-error.log}"
export AURGEN_LOG
export AURGEN_ERROR_LOG

# Clear logs at start
: > "$AURGEN_LOG"
: > "$AURGEN_ERROR_LOG"

# Clear inherited color escapes before colors.sh loads, and validate COLOR early.
unset RED GREEN YELLOW SILVER CYAN RESET
if [[ -n "${COLOR:-}" && "$COLOR" != "0" && "$COLOR" != "1" ]]; then
    printf 'Invalid COLOR: %s (expected 0 or 1)\n' "$COLOR" >&2
    exit 1
fi
if [[ -n "${AURGEN_NON_INTERACTIVE:-}" && "$AURGEN_NON_INTERACTIVE" != "0" && "$AURGEN_NON_INTERACTIVE" != "1" ]]; then
    printf 'Invalid AURGEN_NON_INTERACTIVE: %s (expected 0 or 1)\n' "$AURGEN_NON_INTERACTIVE" >&2
    exit 1
fi
# dry_run and no_wait are compared numerically; DRY_RUN=true would silently run for real.
for _bool_var in DRY_RUN NO_WAIT; do
    if [[ -n "${!_bool_var:-}" && "${!_bool_var}" != "0" && "${!_bool_var}" != "1" ]]; then
        printf 'Invalid %s: %s (expected 0 or 1)\n' "$_bool_var" "${!_bool_var}" >&2
        exit 1
    fi
done
unset _bool_var
if [[ -n "${AURGEN_OVERWRITE_ASSETS:-}" && "$AURGEN_OVERWRITE_ASSETS" != "0" && "$AURGEN_OVERWRITE_ASSETS" != "1" ]]; then
    printf 'Invalid AURGEN_OVERWRITE_ASSETS: %s (expected 0 or 1)\n' "$AURGEN_OVERWRITE_ASSETS" >&2
    exit 1
fi

# Set library and debug level based on RELEASE mode
# RELEASE=1 (or true): use AURGEN_LIB_DIR when it names a directory, else /usr/lib/aurgen,
# and default debug logging to off (DEBUG_LEVEL=0).
# RELEASE=0: use the checkout lib (../lib) and enable debug logging (DEBUG_LEVEL=1).
# A checkout is detected below; CI does not change the mode, so an installed
# aurgen run with CI=1 (aurgen test does this) stays in release mode.
# A source checkout (bin/ next to lib/) must use its own lib, not an older installed copy
if [[ -z "${RELEASE+x}" && -f "$PROJECT_ROOT/lib/helpers.sh" ]]; then
    RELEASE=0
fi
RELEASE=${RELEASE:-1}
if [[ "$RELEASE" == "1" || "$RELEASE" == "true" ]]; then
    # A copied bin/aurgen finds its lib through AURGEN_LIB_DIR, as README states.
    if [[ -n "${AURGEN_LIB_DIR:-}" && -d "$AURGEN_LIB_DIR" ]]; then
        AURGEN_LIB_DIR="$(CDPATH='' cd -- "$AURGEN_LIB_DIR" && pwd)"
        LIB_INSTALL_DIR="$AURGEN_LIB_DIR"
    else
        LIB_INSTALL_DIR="/usr/lib/aurgen"
    fi
    if [[ ! -d "$LIB_INSTALL_DIR" ]]; then
        printf '%b[WARNING] AURGen release library directory not found: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$LIB_INSTALL_DIR" "${RESET:-}" >&2
        printf '%b\n' "${RED:-}" >&2
        if [[ -t 2 && -z "${CI:-}" ]]; then
            printf '%bFalling back to development mode (RELEASE=0) in 5 seconds...%b\n' "${RED:-}" "${RESET:-}" >&2
            printf '%b\n' "${RED:-}" >&2
            sleep 5
        else
            printf '%bFalling back to development mode (RELEASE=0)...%b\n' "${RED:-}" "${RESET:-}" >&2
            printf '%b\n' "${RED:-}" >&2
        fi
        # Fall back to development mode
        RELEASE=0
        # Reset LIB_INSTALL_DIR to ensure it gets set by development mode logic
        unset LIB_INSTALL_DIR
    fi
fi

if [[ "$RELEASE" == "1" || "$RELEASE" == "true" ]]; then
    export DEBUG_LEVEL=${DEBUG_LEVEL:-0}
else
    # Fallback search for development lib dir
    if [[ -n "$AURGEN_LIB_DIR" && -d "$AURGEN_LIB_DIR" ]]; then
        AURGEN_LIB_DIR="$(CDPATH='' cd -- "$AURGEN_LIB_DIR" && pwd)"
        LIB_INSTALL_DIR="$AURGEN_LIB_DIR"
    elif [[ -f "$PROJECT_ROOT/lib/helpers.sh" ]]; then
        LIB_INSTALL_DIR="$PROJECT_ROOT/lib"
    elif [[ -f "$(dirname "$(realpath "$0")")/../lib/helpers.sh" ]]; then
        LIB_INSTALL_DIR="$(dirname "$(realpath "$0")")/../lib"
    elif [[ -f "$PWD/lib/helpers.sh" ]]; then
        LIB_INSTALL_DIR="$PWD/lib"
    elif [[ -f "$PWD/../lib/helpers.sh" ]]; then
        LIB_INSTALL_DIR="$PWD/../lib"
    else
        printf '%bCould not locate AURGen lib directory%b\n' "${RED:-}" "${RESET:-}" >&2
        printf '%b\n' "${RED:-}" >&2
        printf '%bTried the following locations:%b\n' "${RED:-}" "${RESET:-}" >&2
        if [[ -n "$AURGEN_LIB_DIR" ]]; then
            printf '%b  AURGEN_LIB_DIR: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$AURGEN_LIB_DIR" "${RESET:-}" >&2
        fi
        printf '%b  Project root: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$PROJECT_ROOT/lib" "${RESET:-}" >&2
        libdir="$(dirname "$(realpath "$0")")"
        printf '%b  Script relative: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$libdir/../lib" "${RESET:-}" >&2
        printf '%b  Current directory: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$PWD/lib" "${RESET:-}" >&2
        printf '%b  Parent directory: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$PWD/../lib" "${RESET:-}" >&2
        printf '%b\n' "${RED:-}" >&2
        printf '%bPlease ensure the lib/ directory is available at one of these locations,%b\n' "${RED:-}" "${RESET:-}" >&2
        printf '%bor set the %b%s%b environment variable to point to the lib directory.%b\n' "${RED:-}" "${CYAN:-}" "AURGEN_LIB_DIR" "${RESET:-}" "${RESET:-}" >&2
        exit 1
    fi
    # Only set DEBUG_LEVEL=1 if not already set in environment
    if [[ -z "${DEBUG_LEVEL+x}" ]]; then
        export DEBUG_LEVEL=1
    fi
    _pre_json=0
    for _arg in "$@"; do
        [[ "$_arg" == "--" ]] && break
        if [[ "$_arg" == "--json" ]]; then
            _pre_json=1
            break
        fi
    done
    if (( _pre_json )); then
        export AURGEN_JSON=1
        echo "[INFO] AURGen is running in DEVELOPMENT mode (RELEASE=0)." >&2
        echo "[INFO] Debug level: $DEBUG_LEVEL" >&2
    else
        echo "[INFO] AURGen is running in DEVELOPMENT mode (RELEASE=0)."
        echo "[INFO] Debug level: $DEBUG_LEVEL"
    fi
    unset _pre_json _arg
fi

# An installed aurgen has no VERSION beside bin/ (/usr/VERSION); the package puts it in the lib dir.
if [[ "$AURGEN_VERSION" == "unknown" && -f "$LIB_INSTALL_DIR/VERSION" ]]; then
    AURGEN_VERSION=$(tr -d '[:space:]' < "$LIB_INSTALL_DIR/VERSION")
    export AURGEN_VERSION
fi

# Initialize color state before sourcing init.sh (which calls init_colors).
if [[ -n "${CI:-}" ]]; then
    # shellcheck disable=SC2034 # Used in sourced scripts
    color_enabled=0
else
    # shellcheck disable=SC2034 # Used in sourced scripts
    color_enabled=1
fi
color_enabled=${COLOR:-$color_enabled}

# Source initialization and helpers
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/helpers.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/valid-modes.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/init.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/tool-mapping.sh"
# Source mode-specific and shared helpers
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/aur.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/git.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/local.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/clean.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/lint.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/golden.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/test.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/config.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/aur-init.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/aur-deploy.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/aur-status.sh"
# shellcheck source=/dev/null
source "$LIB_INSTALL_DIR/modes/doctor.sh"

# --- Mode Logic ---

# Re-apply color state after sourcing all libraries so early CLI checks match CI and COLOR.
if [[ -n "${CI:-}" ]]; then
    # shellcheck disable=SC2034 # Used in sourced scripts
    color_enabled=0
else
    # shellcheck disable=SC2034 # Used in sourced scripts
    color_enabled=1
fi
color_enabled=${COLOR:-$color_enabled}
init_colors
# shellcheck disable=SC2034 # Used in sourced scripts
ascii_armor=${ASCII_ARMOR_DEFAULT:-0}
# shellcheck disable=SC2034 # Used in sourced scripts
dry_run=${DRY_RUN:-0}
export build_only=0
export nocheck=0
unset AURGEN_NOCHECK
# shellcheck disable=SC2034 # Used in sourced scripts
no_wait=${NO_WAIT:-0}
deploy=0
unset AURGEN_ROLLBACK
export AURGEN_ROLLBACK=0
rollback=0
export AURGEN_STATUS_DIFF=0
status_diff=0
doctor_online=0
notes_file_given=0
status_json=0
non_interactive=${AURGEN_NON_INTERACTIVE:-0}
overwrite_assets=${AURGEN_OVERWRITE_ASSETS:-0}
overwrite_assets_cli=0
# shellcheck disable=SC2034 # Used in sourced scripts
maxdepth=${MAXDEPTH:-5}
config_file_opt=""
config_file_set=0

# Use getopt for unified short and long option parsing
if ! command -v getopt >/dev/null 2>&1; then
    printf '%bMissing required tool: %b%s%b\n' "${RED:-}" "${CYAN:-}" "getopt" "${RESET:-}" >&2
    printf '%b[AURGen] Hint: Install %b%s%b with: %bsudo pacman -S %s%b (GNU getopt required)%b\n' \
        "${YELLOW:-}" "${CYAN:-}" "getopt" "${YELLOW:-}" "${GREEN:-}" "util-linux" "${YELLOW:-}" "${RESET:-}" >&2
    printf '%b\n' "${RED:-}" >&2
    printf '%bNote: AURGen requires GNU getopt from util-linux package.%b\n' "${RED:-}" "${RESET:-}" >&2
    printf '%bBSD/macOS getopt implementations are not supported.%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
# util-linux getopt exits 4 for -T. Parsing argv here reports a bad option as a missing getopt.
getopt_probe=0
getopt -T >/dev/null 2>&1 || getopt_probe=$?
if (( getopt_probe != 4 )); then
    printf '%bGNU getopt required (util-linux).%b\n' "${RED:-}" "${RESET:-}" >&2
    printf '%b[AURGen] Hint: Install %b%s%b with: %bsudo pacman -S %s%b\n' \
        "${YELLOW:-}" "${CYAN:-}" "getopt" "${YELLOW:-}" "${GREEN:-}" "util-linux" "${RESET:-}" >&2
    exit 1
fi
trap - ERR
set +e
getopt_output=$(getopt --shell bash -o nac:dhv --long no-color,ascii-armor,config:,dry-run,build-only,nocheck,help,usage,no-wait,overwrite-assets,deploy,rollback,diff,online,notes-file:,json,non-interactive,maxdepth:,version -- "$@")
getopt_status=$?
set -e
trap 'printf "%b[FATAL] %b%s%b:%b%s%b: %b%s%b\n" "${RED:-}" "${CYAN:-}" "${BASH_SOURCE[0]}" "${RED:-}" "${LINENO}" "${RED:-}" "${BASH_COMMAND}" "${RESET:-}" >&2' ERR
if (( getopt_status != 0 )); then
    printf 'Error: Failed to parse options.\n' >&2
    help
    exit 1
fi
eval set -- "$getopt_output"
while true; do
    case "$1" in
        -n|--no-color)
            # shellcheck disable=SC2034 # Used in sourced scripts
            color_enabled=0; shift ;;
        -a|--ascii-armor)
            # shellcheck disable=SC2034 # Used in sourced scripts
            ascii_armor=1
            # golden and test run aurgen again for each mode; ASCII_ARMOR_DEFAULT carries -a there.
            export ASCII_ARMOR_DEFAULT=1
            shift ;;
        -c|--config)
            config_file_opt="$2"; config_file_set=1; shift 2 ;;
        -d|--dry-run)
            # shellcheck disable=SC2034 # Used in sourced scripts
            dry_run=1; shift ;;
        --build-only)
            build_only=1; shift ;;
        --nocheck)
            nocheck=1; shift ;;
        --no-wait)
            # shellcheck disable=SC2034 # Used in sourced scripts
            no_wait=1; shift ;;
        --overwrite-assets)
            overwrite_assets=1; overwrite_assets_cli=1; shift ;;
        --deploy)
            deploy=1; shift ;;
        --rollback)
            rollback=1; shift ;;
        --diff)
            status_diff=1; shift ;;
        --online)
            doctor_online=1; shift ;;
        --notes-file)
            notes_file_given=1; AURGEN_RELEASE_NOTES_FILE="$2"; shift 2 ;;
        --json)
            status_json=1; shift ;;
        --non-interactive)
            non_interactive=1; shift ;;
        --maxdepth)
            # shellcheck disable=SC2034 # Used in sourced scripts
            maxdepth="$2"; shift 2 ;;
        -h|--help)
            help; exit 0 ;;
        -v|--version)
            echo "aurgen version $AURGEN_VERSION"
            exit 0 ;;
        --usage)
            usage; exit 0 ;;
        --)
            shift; break ;;
        *)
            printf '%bUnknown option: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$1" "${RESET:-}" >&2; help; exit 1 ;;
    esac
    # No need to call init_colors here
    # We'll call it once after all flags are parsed
    # This ensures color_enabled is set correctly
    # and color variables are initialized accordingly
    # (see below)
done

# find fails on a bad -maxdepth inside a process substitution, so lint would
# report no files and exit 0.
if [[ ! "$maxdepth" =~ ^[1-9][0-9]*$ ]]; then
    echo "Invalid --maxdepth: $maxdepth (expected a positive integer)" >&2
    exit 1
fi
# Export maxdepth for use in sourced scripts
export MAXDEPTH="$maxdepth"

if (( config_file_set )); then
    if [[ -z "$config_file_opt" ]]; then
        printf '%b--config requires a non-empty file path%b\n' "${RED:-}" "${RESET:-}" >&2
        exit 1
    fi
    if [[ -d "$config_file_opt" ]]; then
        printf '%b--config path is a directory: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$config_file_opt" "${RESET:-}" >&2
        exit 1
    fi
    # Resolve before any directory changes so relative -c paths stay relative to caller CWD.
    AURGEN_CONFIG_FILE="$(realpath -m -- "$config_file_opt")"
    export AURGEN_CONFIG_FILE
elif [[ -n "${AURGEN_CONFIG_FILE:-}" ]]; then
    if [[ -d "$AURGEN_CONFIG_FILE" ]]; then
        printf '%bAURGEN_CONFIG_FILE is a directory: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$AURGEN_CONFIG_FILE" "${RESET:-}" >&2
        exit 1
    fi
    AURGEN_CONFIG_FILE="$(realpath -m -- "$AURGEN_CONFIG_FILE")"
    export AURGEN_CONFIG_FILE
fi

# Resolve before update_checksums and generate_srcinfo cd into aur/. An empty
# value stays empty so install_pkg keeps the host build. realpath -m leaves a
# canonical absolute path unchanged and anchors a relative one at the caller cwd
# (the project root when aurgen is started there).
if [[ -n "${AURGEN_CHROOT_DIR:-}" ]]; then
    AURGEN_CHROOT_DIR="$(realpath -m -- "$AURGEN_CHROOT_DIR")"
    export AURGEN_CHROOT_DIR
fi
if [[ -n "${AURGEN_RELEASE_NOTES_FILE:-}" ]]; then
    AURGEN_RELEASE_NOTES_FILE="$(realpath -m -- "$AURGEN_RELEASE_NOTES_FILE")"
    export AURGEN_RELEASE_NOTES_FILE
fi

# COLOR overrides --no-color and CI; it must be set before init_colors picks the escapes.
color_enabled=${COLOR:-$color_enabled}
init_colors

# If no mode is given, print usage and exit
if [[ -z ${1:-} ]]; then
    usage
    exit 1
fi
MODE=$1
shift
# Store remaining arguments for config mode
CONFIG_ARGS=("$@")
# Allow additional arguments for config mode
if [[ $# -gt 0 && "$MODE" != "config" ]]; then
    printf '%bUnexpected argument(s): %b%s%b\n' "${RED:-}" "${CYAN:-}" "$*" "${RESET:-}" >&2
    usage
    exit 1
fi
if ! is_valid_mode "$MODE"; then
    # Suggest closest valid mode
    closest=""
    min_dist=999
    for m in "${VALID_MODES[@]}"; do
        dist=$(awk -v a="$MODE" -v b="$m" '
        function min(x,y){return x<y?x:y}
        BEGIN{
            n=length(a); m=length(b)
            for(i=0;i<=n;i++) d[i,0]=i
            for(j=0;j<=m;j++) d[0,j]=j
            for(i=1;i<=n;i++) {
                for(j=1;j<=m;j++) {
                    cost=(substr(a,i,1)==substr(b,j,1)?0:1)
                    d[i,j]=min(min(d[i-1,j]+1,d[i,j-1]+1),d[i-1,j-1]+cost)
                }
            }
            print d[n,m]
        }')
        if (( dist < min_dist )); then
            min_dist=$dist
            closest=$m
        fi
    done
    if (( min_dist <= 3 )); then
        printf '%bUnknown mode: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$MODE" "${RESET:-}" >&2
        printf '%bDid you mean "%b%s%b"?%b\n' "${YELLOW:-}" "${CYAN:-}" "$closest" "${YELLOW:-}" "${RESET:-}" >&2
        exit 1
    else
        printf '%bUnknown mode: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$MODE" "${RESET:-}" >&2
        usage
        exit 1
    fi
fi
if (( build_only && deploy )); then
    printf '%b--build-only cannot be combined with --deploy%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
if (( build_only )) && [[ "$MODE" != "local" && "$MODE" != "aur" && "$MODE" != "git" ]]; then
    printf '%b--build-only is only valid with local, aur or git%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
is_build_mode=0
if [[ "$MODE" == "local" ]] || { [[ "$MODE" == "aur" || "$MODE" == "git" ]] && (( build_only )); }; then
    is_build_mode=1
fi
if (( nocheck && ! is_build_mode )); then
    printf '%b--nocheck is only valid with local, or aur/git with --build-only%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
if [[ -n "${AURGEN_MAKEPKG_FLAGS:-}" ]] && (( is_build_mode )); then
    _preflight_makepkg_flags=()
    if ! _validate_and_collect_makepkg_flags _preflight_makepkg_flags; then
        exit 1
    fi
    unset _preflight_makepkg_flags
fi
unset is_build_mode
if (( deploy )) && [[ "$MODE" != "aur" && "$MODE" != "git" ]]; then
    printf '%b--deploy is only valid with aur or git%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
if (( overwrite_assets_cli )) && [[ "$MODE" != "aur" ]]; then
    printf '%b--overwrite-assets is only valid with aur%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
# shellcheck disable=SC2034 # Read by lib/modes/aur.sh
export AURGEN_OVERWRITE_ASSETS="$overwrite_assets"
if (( rollback )) && [[ "$MODE" != "aur-deploy" ]]; then
    printf '%b--rollback is only valid with aur-deploy%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
# shellcheck disable=SC2034 # Read by lib/modes/aur-deploy.sh and lib/aur-integration.sh
export AURGEN_ROLLBACK="$rollback"
if (( status_diff && status_json )); then
    printf '%b--diff cannot be combined with --json%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
if (( status_json && deploy )); then
    printf '%b--json cannot be combined with --deploy%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
if (( status_diff )) && [[ "$MODE" != "aur-status" ]]; then
    printf '%b--diff is only valid with aur-status%b\n' "${RED:-}" "${RESET:-}" >&2
    exit 1
fi
if (( doctor_online )); then
    if [[ "$MODE" != "doctor" ]]; then
        printf '%b--online is only valid with doctor%b\n' "${RED:-}" "${RESET:-}" >&2
        exit 1
    fi
    export AURGEN_DOCTOR_ONLINE=1
elif [[ "$MODE" == "doctor" && -n "${AURGEN_DOCTOR_ONLINE:-}" && "$AURGEN_DOCTOR_ONLINE" != "0" && "$AURGEN_DOCTOR_ONLINE" != "1" ]]; then
    # Only doctor reads it, so only doctor rejects a value that would silently mean offline.
    printf 'Invalid AURGEN_DOCTOR_ONLINE: %s (expected 0 or 1)\n' "$AURGEN_DOCTOR_ONLINE" >&2
    exit 1
fi
if (( notes_file_given )); then
    if [[ "$MODE" != "aur" ]]; then
        printf '%b--notes-file is only valid with aur%b\n' "${RED:-}" "${RESET:-}" >&2
        exit 1
    fi
    # An empty value would silently fall back to generated notes.
    if [[ -z "${AURGEN_RELEASE_NOTES_FILE:-}" ]]; then
        printf '%b--notes-file needs a file%b\n' "${RED:-}" "${RESET:-}" >&2
        exit 1
    fi
fi
# Check the notes file before aurgen_init and cleanup change anything in the project.
if [[ "$MODE" == "aur" && -n "${AURGEN_RELEASE_NOTES_FILE:-}" ]] && \
    [[ ! -f "$AURGEN_RELEASE_NOTES_FILE" || ! -r "$AURGEN_RELEASE_NOTES_FILE" ]]; then
    printf '%b[aur] AURGEN_RELEASE_NOTES_FILE is not a readable file: %s%b\n' "${RED:-}" "$AURGEN_RELEASE_NOTES_FILE" "${RESET:-}" >&2
    exit 1
fi
if [[ "$MODE" == "config" ]]; then
    export AURGEN_CONFIG_ACTION="${CONFIG_ARGS[0]:-}"
else
    unset AURGEN_CONFIG_ACTION
fi
if (( status_json )); then
    case "$MODE" in
        aur|aur-status|doctor|lint|test) ;;
        config)
            case "${AURGEN_CONFIG_ACTION:-}" in
                detect) ;;
                show|s|list|l)
                    if [[ "${CONFIG_ARGS[1]:-}" != "effective" ]]; then
                        printf '%b--json is only valid with aur, aur-status, doctor, config detect, config show effective, lint, or test%b\n' "${RED:-}" "${RESET:-}" >&2
                        exit 1
                    fi
                    ;;
                *)
                    printf '%b--json is only valid with aur, aur-status, doctor, config detect, config show effective, lint, or test%b\n' "${RED:-}" "${RESET:-}" >&2
                    exit 1
                    ;;
            esac
            ;;
        *)
            printf '%b--json is only valid with aur, aur-status, doctor, config detect, config show effective, lint, or test%b\n' "${RED:-}" "${RESET:-}" >&2
            exit 1
            ;;
    esac
fi
# shellcheck disable=SC2034 # Read by lib/aur-integration.sh and lib/helpers.sh
export AURGEN_STATUS_DIFF="$status_diff"
# shellcheck disable=SC2034 # Read by lib/modes/aur.sh, lib/modes/aur-status.sh, lib/modes/doctor.sh, lib/modes/config.sh, lib/modes/lint.sh, lib/modes/test.sh and lib/helpers.sh
export AURGEN_JSON="$status_json"
# shellcheck disable=SC2034 # Read by lib/helpers.sh and lib/modes/config.sh
export AURGEN_NON_INTERACTIVE="$non_interactive"
if (( dry_run )) && [[ "$MODE" == "clean" ]]; then
    err "clean has no dry run: it deletes generated files. Run 'aurgen clean' without --dry-run."
    exit 1
fi
if (( dry_run )) && [[ "$MODE" == "golden" ]]; then
    err "[golden] golden has no dry run: it cleans and regenerates aur/ outputs"
    exit 1
fi

export AURGEN_MODE="$MODE"

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
    err "Bash ≥ 4.4 required" >&2
    exit 1
fi
if [[ "$MODE" == "doctor" ]]; then
    status=0
    mode_doctor || status=$?
    exit "$status"
fi
if ! command -v git >/dev/null 2>&1; then
    require git || exit 1
fi
if ! git rev-parse --show-toplevel >/dev/null 2>>"$AURGEN_ERROR_LOG"; then
    echo "[aurgen] ERROR: This script must be run inside a git repository (no .git found)." >&2
    exit 1
fi

# Enforce GitHub project requirement before side-effectful initialization
REPO_URL=$(git config --get remote.origin.url || true)
# The host must be github.com itself: an optional scheme and user, then the host.
github_remote_re='^([[:alnum:]+.-]+://)?([^/@]+@)?((www|ssh)\.)?github\.com[:/][^/]+/[^/]+$'
if [[ ! "$REPO_URL" =~ $github_remote_re ]]; then
    if (( color_enabled )); then
        printf '%bAURGen only supports GitHub projects%b\n' "${RED:-}" "${RESET:-}" >&2
        printf '%b\n' "${RED:-}" >&2
        if [[ -n "$REPO_URL" ]]; then
            printf '%bCurrent repository URL: %b%s%b\n' "${RED:-}" "${CYAN:-}" "$REPO_URL" "${RESET:-}" >&2
            printf '%bThis does not appear to be a GitHub repository.%b\n' "${RED:-}" "${RESET:-}" >&2
        else
            printf '%bNo remote origin URL found. Please set up a GitHub remote:%b\n' "${RED:-}" "${RESET:-}" >&2
            printf '%b  %b%s%b\n' "${RED:-}" "${GREEN:-}" "git remote add origin https://github.com/username/repository.git" "${RESET:-}" >&2
        fi
        printf '%b\n' "${RED:-}" >&2
        printf '%bAURGen is designed specifically for GitHub projects and requires%b\n' "${RED:-}" "${RESET:-}" >&2
        printf '%ba valid GitHub repository URL to function properly.%b\n' "${RED:-}" "${RESET:-}" >&2
    else
        err "AURGen only supports GitHub projects"
        err ""
        if [[ -n "$REPO_URL" ]]; then
            err "Current repository URL: $REPO_URL"
            err "This does not appear to be a GitHub repository."
        else
            err "No remote origin URL found. Please set up a GitHub remote:"
            err "  git remote add origin https://github.com/username/repository.git"
        fi
        err ""
        err "AURGen is designed specifically for GitHub projects and requires"
        err "a valid GitHub repository URL to function properly."
    fi
    exit 1
fi

# --- Dependency checks: fail fast before side-effectful initialization ---
case "$MODE" in
    local)
        require makepkg updpkgsums curl || exit 1
        ;;
    aur)
        require makepkg updpkgsums curl gpg jq || exit 1
        ;;
    git)
        require makepkg || exit 1
        ;;
    aur-init)
        require git || exit 1
        ;;
    aur-deploy)
        if (( rollback )); then
            require git || exit 1
        else
            require makepkg git || exit 1
        fi
        ;;
    aur-push)
        require git || exit 1
        ;;
    aur-status)
        require git || exit 1
        ;;
    lint)
        require bash || exit 1
        # Note: shellcheck is optional for lint mode - it will be skipped if not available
        ;;
    golden)
        require makepkg updpkgsums curl gpg jq || exit 1
        ;;
    config)
        # No special tools required for config mode
        ;;
    # clean and test modes do not require special tools
esac

# Only now perform side-effectful initialization
if (( status_json )); then
    aurgen_init >&2
else
    aurgen_init
fi

_AURGEN_RECOVERY_DIR=""
_AURGEN_HAD_PKGBUILD=0
_AURGEN_HAD_SRCINFO=0
_AURGEN_ARTIFACTS_COMMITTED=0
# Release tarball and signature paths this run created. Empty when it created none.
_AURGEN_RUN_ARTIFACTS=()

_aurgen_on_mode_exit() {
    local rc=$?
    trap '' ERR
    local tmp_dir="${_AURGEN_RECOVERY_DIR:-}"
    local artifact=""
    _AURGEN_RECOVERY_DIR=""
    if (( rc != 0 && ! ${_AURGEN_ARTIFACTS_COMMITTED:-0} )); then
        local out_target="${OUT_DIR:-${AUR_DIR:-}}"
        if [[ -n "$out_target" ]]; then
            rm -f "${PKGBUILD:-$out_target/PKGBUILD}" "${PKGBUILD:-$out_target/PKGBUILD}.tmp" \
                "$out_target/PKGBUILD.git" "${SRCINFO:-$out_target/.SRCINFO}" || true
            if (( _AURGEN_HAD_PKGBUILD )) && [[ -n "$tmp_dir" && -f "$tmp_dir/PKGBUILD" ]]; then
                cp -f -- "$tmp_dir/PKGBUILD" "$PKGBUILD" || true
            fi
            if (( _AURGEN_HAD_SRCINFO )) && [[ -n "$tmp_dir" && -f "$tmp_dir/.SRCINFO" ]]; then
                cp -f -- "$tmp_dir/.SRCINFO" "$SRCINFO" || true
            fi
            if (( _AURGEN_HAD_PKGBUILD || _AURGEN_HAD_SRCINFO )); then
                warn "[aurgen] Mode '$MODE' failed before finishing packaging files; restored previous PKGBUILD/.SRCINFO state."
            else
                warn "[aurgen] Mode '$MODE' failed before finishing packaging files; removed partial generated files."
            fi
        fi
        # Only paths _aur_prepare_release_archive recorded. A file this run did not create stays.
        for artifact in ${_AURGEN_RUN_ARTIFACTS[@]+"${_AURGEN_RUN_ARTIFACTS[@]}"}; do
            [[ -n "$artifact" ]] || continue
            rm -f -- "$artifact" || true
        done
    fi
    if [[ -n "$tmp_dir" ]]; then
        rm -rf -- "$tmp_dir" || true
    fi
}

# Clean up only after initialization and preflight checks succeed.
case "$MODE" in
    local|aur|git)
        if (( ! dry_run && ${AURGEN_KEEP_PREV:-0} != 1 )); then
            _AURGEN_RECOVERY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/aurgen-recovery.XXXXXX")" || exit 1
            if [[ -f "$PKGBUILD" ]]; then
                cp -p -- "$PKGBUILD" "$_AURGEN_RECOVERY_DIR/PKGBUILD" || { rm -rf -- "$_AURGEN_RECOVERY_DIR"; exit 1; }
                _AURGEN_HAD_PKGBUILD=1
            fi
            if [[ -f "$SRCINFO" ]]; then
                cp -p -- "$SRCINFO" "$_AURGEN_RECOVERY_DIR/.SRCINFO" || { rm -rf -- "$_AURGEN_RECOVERY_DIR"; exit 1; }
                _AURGEN_HAD_SRCINFO=1
            fi
            trap _aurgen_on_mode_exit EXIT
        fi
        cleanup
        ;;
esac

log "Running in \"$MODE\" mode"
case "$MODE" in
    local)
        mode_local || exit $?
        ;;
    aur)
        mode_aur || exit $?
        if (( deploy )); then
            mode_aur_deploy || exit 1
        fi
        ;;
    git)
        mode_git || exit $?
        if (( deploy )); then
            mode_aur_deploy || exit 1
        fi
        ;;
    aur-init)
        status=0
        mode_aur_init || status=$?
        exit "$status"
        ;;
    aur-deploy)
        status=0
        mode_aur_deploy || status=$?
        exit "$status"
        ;;
    aur-push)
        status=0
        mode_aur_push || status=$?
        exit "$status"
        ;;
    aur-status)
        status=0
        mode_aur_status || status=$?
        exit "$status"
        ;;
    clean)
        # clean only deletes; a dry run must not remove anything.
        if (( dry_run )); then
            err "clean has no dry run: it deletes generated files. Run 'aurgen clean' without --dry-run."
            exit 1
        fi
        mode_clean
        exit 0
        ;;
    test)
        mode_test
        exit 0
        ;;
    lint)
        mode_lint
        ;;
    golden)
        mode_golden
        exit 0
        ;;
    config)
        # Pass stored arguments to config mode
        status=0
        mode_config "${CONFIG_ARGS[@]}" || status=$?
        exit "$status"
        ;;
esac
