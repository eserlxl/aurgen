set -euo pipefail

# Bash ranges follow LC_COLLATE; move LC_ALL to LANG before pinning collation to C.
if [[ -n "${LC_ALL:-}" ]]; then
    export LANG="$LC_ALL"
    unset LC_ALL
fi
export LC_COLLATE=C

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Source libraries
# shellcheck source=/dev/null
source "$LIB_DIR/expand-mapping.sh"

# Configuration
TEMP_DIR="${TMPDIR:-/tmp}/aurgen-mapping"
WORKFLOW_LOG="$TEMP_DIR/workflow.log"

# Create temp directory
mkdir -p "$TEMP_DIR"

# Log function
log_workflow() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$WORKFLOW_LOG"
}

# Show usage
show_usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] COMMAND

Commands:
  workflow    Run complete workflow: expand → apply (default)
  expand      Expand tool mappings only
  check       Check current state and available updates
  status      Show current mapping statistics

Options:
  -d, --dry-run   Show what would be done without making changes
  -h, --help      Show this help message

Examples:
  $(basename "$0") workflow    # Run complete workflow
  $(basename "$0") expand      # Expand mappings only
  $(basename "$0") --dry-run   # Show what would be done

The complete workflow performs:
1. Expand mappings from built-in defaults and installed system packages (pacman -Qo)
2. Apply new mappings to lib/tool-mapping.sh while preserving existing mappings
3. Show final mapping statistics

EOF
}

# Count mapping arms matching a category pattern (empty arms yields 0).
_count_mapping_category() {
    local arms="$1"
    local pattern="$2"
    if [[ -z "$arms" ]]; then
        printf '0\n'
        return 0
    fi
    LC_ALL=C grep -c -E "$pattern" <<< "$arms" || true
}

# Check current mapping statistics
show_mapping_stats() {
    local tool_mapping_file="$LIB_DIR/tool-mapping.sh"
    if [[ ! -f "$tool_mapping_file" ]]; then
        echo "Mapping file not found: $tool_mapping_file" >&2
        return 1
    fi
    local arm_re='^[[:space:]]*[a-zA-Z0-9_.+-]+\)[[:space:]]*echo[[:space:]]*"[^"]*"[[:space:]]*;;[[:space:]]*$'
    local arms
    arms=$(LC_ALL=C grep -E "$arm_re" "$tool_mapping_file" || true)

    echo "Current mapping statistics:"
    echo "=========================="

    # Count total mappings
    local total_mappings=0
    if [[ -n "$arms" ]]; then
        total_mappings=$(LC_ALL=C grep -c '^' <<< "$arms")
    fi
    echo "  Total mappings: $total_mappings"

    # Count by category (anchored to extracted mapping arms only)
    echo
    echo "Mappings by category:"
    echo "  Build tools: $(_count_mapping_category "$arms" '(cmake|make|ninja|autoconf|automake|libtool|meson)')"
    echo "  Compilers/Languages: $(_count_mapping_category "$arms" '(gcc|clang|python|node|rust|go|java)')"
    echo "  Package managers: $(_count_mapping_category "$arms" '(npm|cargo|maven|gradle|pip|poetry)')"
    echo "  System tools: $(_count_mapping_category "$arms" '(getopt|ssh|systemctl|dbus|tar|gzip|bzip2|xz|zstd)')"
    echo "  Qt tools: $(_count_mapping_category "$arms" '(qmake|moc|uic|rcc|qt)')"
    echo "  GTK tools: $(_count_mapping_category "$arms" '(gtk|glib)')"
    echo "  Database tools: $(_count_mapping_category "$arms" '(sqlite3|psql|mysql|mongosh|redis-cli)')"
    echo "  Media tools: $(_count_mapping_category "$arms" '(ffmpeg|ffplay|ffprobe|convert|identify|mogrify)')"
    echo "  Security tools: $(_count_mapping_category "$arms" '(gpg|gpg-agent|gpgconf|openssl)')"

    echo
    echo "Last updated: $(stat -c %y "$tool_mapping_file" 2>/dev/null || echo "Unknown")"
}

# Check for available updates
check_updates() {
    echo "Checking for available updates..."
    echo "================================="
    
    echo
    echo "1. Mapping Sources:"
    echo "   - Built-in common tool mappings: Available"
    if command -v pacman >/dev/null 2>&1; then
        echo "   - System package ownership (pacman -Qo): Available"
    else
        echo "   - System package ownership (pacman -Qo): Unavailable (pacman not found)"
    fi
    
    echo
    echo "2. Update Policy:"
    echo "   - Existing and self-mappings: Preserved"
    echo "   - New mappings: Applied automatically to lib/tool-mapping.sh"
    
    echo
    echo "Run '$(basename "$0") workflow' to apply all updates."
}

# Run expansion step
run_expansion() {
    log_workflow "Starting mapping expansion..."
    expand_tool_mapping
    log_workflow "Mapping expansion completed."
}

# Run complete workflow
run_workflow() {
    local dry_run="${1:-false}"
    
    echo "Starting complete tool mapping update workflow..."
    echo "=================================================="
    
    if [[ "$dry_run" == "true" ]]; then
        echo "DRY RUN MODE - No changes will be made"
        echo
        echo "Workflow steps:"
        echo "1. Expand mappings from built-in defaults and installed system packages (pacman -Qo)"
        echo "2. Apply new mappings to lib/tool-mapping.sh (existing and self-mappings preserved)"
        echo "3. Show final mapping statistics"
        echo
        echo "Run without --dry-run to apply changes."
        return 0
    fi
    
    # Step 1: Expand mappings
    echo
    echo "Step 1: Expanding mappings..."
    echo "----------------------------"
    run_expansion
    
    # Step 2: Show final statistics
    echo
    echo "Step 2: Final statistics..."
    echo "--------------------------"
    show_mapping_stats
    
    # Step 3: Summary
    echo
    echo "Workflow completed successfully!"
    echo "==============================="
    echo
    echo "Files created:"
    echo "  - Workflow log: $WORKFLOW_LOG"
    echo "  - Expansion files: $TEMP_DIR/expanded-mapping.txt"
    echo
    echo "Backups created:"
    echo "  - Expansion backup: $TEMP_DIR/tool-mapping.sh.backup"
    echo
    echo "Next steps:"
    echo "  1. Review the changes in lib/tool-mapping.sh"
    echo "  2. Test AURGen with the updated mappings"
    echo "  3. Commit the changes: git add lib/tool-mapping.sh && git commit -m 'Update tool mapping'"
    echo
    echo "To restore from backup:"
    echo "  cp $TEMP_DIR/tool-mapping.sh.backup lib/tool-mapping.sh"
}

# Main function
main() {
    local command="workflow"
    local dry_run=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_usage
                exit 0
                ;;
            -d|--dry-run)
                dry_run=true
                shift
                ;;
            workflow|expand|check|status)
                command="$1"
                shift
                ;;
            *)
                echo "Unknown option: $1" >&2
                show_usage >&2
                exit 1
                ;;
        esac
    done

    # Execute command
    case "$command" in
        workflow)
            run_workflow "$dry_run"
            ;;
        expand)
            if [[ "$dry_run" == "true" ]]; then
                echo "DRY RUN: would expand tool mappings (expand_tool_mapping)"
                echo "Run without --dry-run to apply changes."
            else
                echo "Running mapping expansion only..."
                run_expansion
            fi
            ;;
        check)
            check_updates
            ;;
        status)
            show_mapping_stats
            ;;
    esac
}

# Run main function
main "$@" 
